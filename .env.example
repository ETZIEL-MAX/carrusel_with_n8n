# Redis (Upstash via Vercel Marketplace, or legacy Vercel KV)
# Auto-populated when you add the Upstash integration in Vercel.
# Either naming works:
KV_REST_API_URL="https://your-store.upstash.io"
KV_REST_API_TOKEN="your-token-here"
# UPSTASH_REDIS_REST_URL="https://your-store.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Admin Authentication
# Generate with: npm run hash:password
# ADMIN_PASSWORD_HASH="$argon2id$v=19$m=19456,t=2,p=1$..."

# JWT Secret for admin sessions (generate with: openssl rand -base64 32)
# JWT_SECRET="your-32-char-base64-secret"

# JWT Expiry (short for security)
# JWT_EXPIRY="1h"

# n8n Webhook Security
# Generate with: openssl rand -base64 32
# WEBHOOK_SECRET="your-32-char-base64-secret"

# Vercel Blob (image re-hosting for /api/upload)
# Auto-injected by Vercel when you create a Blob store.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Blob access mode: public (default) or private. Use public for a public carousel.
# BLOB_ACCESS="public"

# Comma-separated host suffixes allowed as image sources for /api/upload
# (prevents SSRF). Defaults to: aliyuncs.com,cloudinary.com,pollinations.ai
# UPLOAD_ALLOWED_HOSTS="aliyuncs.com,cloudinary.com,pollinations.ai"

# Max image size (bytes) accepted by /api/upload. Default 15 MB.
# UPLOAD_MAX_BYTES="15728640"

# Download timeout (ms) for /api/upload. Default 20000.
# UPLOAD_FETCH_TIMEOUT="20000"

# Optional: Rate limiting (requests per minute per IP)
# RATE_LIMIT_IMAGES="60"
# RATE_LIMIT_WEBHOOK="10"
# RATE_LIMIT_AUTH="5"

# --- Token por cliente, espacio y consumo ---
# Llave que cifra el token de webhook de cada cliente (mínimo 32 caracteres).
# Generar con: openssl rand -hex 32. Si se pierde o cambia, hay que regenerar los tokens.
# TOKEN_ENC_KEY="..."

# Mientras un cliente no tenga token propio se acepta la firma global (WEBHOOK_SECRET),
# que firma solo el cuerpo y no lleva marca de tiempo (se puede reenviar). Poner en 0
# cuando todos los clientes tengan token propio (crt_, firma con marca de tiempo y un
# solo uso). En producción ya está en 0 (ver deploy/docker-compose.prod.yml).
# ALLOW_GLOBAL_WEBHOOK_SECRET="0"

# Espacio por usuario cuando no tiene un límite propio (MB).
# DEFAULT_STORAGE_MB="500"

# Precio aproximado por imagen sin tokens reportados (USD). Editable en el panel.
# IMAGE_PRICE_USD="0.06"

# Sesiones y login
# ADMIN_JWT_EXPIRY="30m"
# LOGIN_MAX_FAILS="10"
# LOGIN_LOCK_SECONDS="900"

# Zona horaria del negocio: con ella se decide qué día es para las imágenes programadas
# (solo viernes, del 17 de oct al 23 de nov...). Default America/Monterrey.
# CAROUSEL_TIMEZONE="America/Monterrey"

# --- URL pública del sitio ---
# Con ella se arman los enlaces de los correos y la URL de vuelta para n8n.
# En producción es obligatoria (nunca se usa el header Host).
# APP_URL="https://carrusel.etziel.com"

# --- Registro propio y recuperación de contraseña ---
# Correo con Resend (https://resend.com). Sin RESEND_API_KEY y fuera de producción,
# los correos se escriben en LOCAL_DATA_DIR/mail/ (bandeja de dev y tests).
# En producción, sin estas variables no se muestra "Crear cuenta" ni "Olvidé mi contraseña".
# RESEND_API_KEY="re_..."
# MAIL_FROM="Carrusel <no-reply@etziel.com>"

# Cloudflare Turnstile (captcha) para el registro y la recuperación.
# Claves de prueba que siempre pasan: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY="0x..."
# TURNSTILE_SECRET_KEY="0x..."

# 0 = cierra el registro (la recuperación de contraseña sigue).
# SIGNUP_ENABLED="1"
# Correos de registro/recuperación por IP y por hora, y espera entre dos correos al mismo correo.
# ACCOUNT_HOURLY_LIMIT="10"
# MAIL_COOLDOWN_SECONDS="120"

# --- n8n ---
# Hosts a los que /api/generate y /api/drafts pueden llamar (el webhook de generación lo fija solo el super-admin).
# N8N_ALLOWED_HOSTS="n8n.ejemplo.com"
# Flujo "Generar desde web" ("Crear con IA" del panel). Sin esta variable (ni un webhook propio del
# carrusel) la sección no aparece. Recibe el header X-Carrusel-Key = N8N_NUMBERS_SECRET.
# N8N_WEB_GENERATION_URL="https://n8n.ejemplo.com/webhook/generar-web"
# Flujo "Alta de número": el panel vincula el WhatsApp de cada cliente en la tabla whatsapp_numeros.
# N8N_NUMBERS_SECRET va en el header X-Carrusel-Key (Header Auth del Webhook en n8n).
# N8N_NUMBERS_WEBHOOK_URL="https://n8n.ejemplo.com/webhook/alta-numero"
# N8N_NUMBERS_SECRET="..."  (openssl rand -hex 32)

# Tope de imágenes generadas al mes por cuenta, hasta que el super-admin lo cambie en el panel.
# MONTHLY_IMAGE_LIMIT="50"
