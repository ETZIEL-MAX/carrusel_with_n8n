# Redis (Upstash via Vercel Marketplace, or legacy Vercel KV)
# Auto-populated when you add the Upstash integration in Vercel.
# Either naming works:
KV_REST_API_URL="https://your-store.upstash.io"
KV_REST_API_TOKEN="your-token-here"
# UPSTASH_REDIS_REST_URL="https://your-store.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Admin Authentication
# Generate with: npm run hash:password
# ADMIN_PASSWORD_HASH="$argon2id$v=19$m=19456,t=2,p=1$..."

# JWT Secret for admin sessions (generate with: openssl rand -base64 32)
# JWT_SECRET="your-32-char-base64-secret"

# JWT Expiry (short for security)
# JWT_EXPIRY="1h"

# n8n Webhook Security
# Generate with: openssl rand -base64 32
# WEBHOOK_SECRET="your-32-char-base64-secret"

# Vercel Blob (image re-hosting for /api/upload)
# Auto-injected by Vercel when you create a Blob store.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Blob access mode: public (default) or private. Use public for a public carousel.
# BLOB_ACCESS="public"

# Comma-separated host suffixes allowed as image sources for /api/upload
# (prevents SSRF). Defaults to: aliyuncs.com,cloudinary.com,pollinations.ai
# UPLOAD_ALLOWED_HOSTS="aliyuncs.com,cloudinary.com,pollinations.ai"

# Max image size (bytes) accepted by /api/upload. Default 15 MB.
# UPLOAD_MAX_BYTES="15728640"

# Download timeout (ms) for /api/upload. Default 20000.
# UPLOAD_FETCH_TIMEOUT="20000"

# Optional: Rate limiting (requests per minute per IP)
# RATE_LIMIT_IMAGES="60"
# RATE_LIMIT_WEBHOOK="10"
# RATE_LIMIT_AUTH="5"
